summary: Exercise sandbox lifecycle and network isolation
duration: 30m
require:
    - enclave
    - podman
    - curl
    - python3
    - util-linux
environment:
    ENCLAVE_TMT_TEST: "1"
test: ./smoke-backend-lifecycle.sh
